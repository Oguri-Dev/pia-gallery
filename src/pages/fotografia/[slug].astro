---
import { Image, getImage } from 'astro:assets';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Lightbox from '../../components/Lightbox.astro';
import Tejuela from '../../components/Tejuela.astro';
import { getSeries } from '../../lib/contenido';

export async function getStaticPaths() {
  const series = await getSeries();
  return series.map((s, i) => ({
    params: { slug: s.id },
    props: { serie: s, siguiente: series[(i + 1) % series.length] },
  }));
}

const { serie, siguiente } = Astro.props;
const { Content } = await render(serie);
const fotos = await Promise.all(
  serie.data.fotos.map(async (f) => ({
    src: f.imagen,
    pie: f.pie,
    grande: (await getImage({ src: f.imagen, width: 1800, format: 'webp' })).src,
    vertical: f.imagen.height > f.imagen.width,
  })),
);
---
<Base titulo={serie.data.titulo} descripcion={`${serie.data.titulo}. ${serie.data.subtitulo}. Fotografía de Pía Gallardo.`}>
  <header class="cabecera-seccion contenedor">
    <a href="/fotografia" class="etiqueta volver">&larr; Fotografía</a>
    <h1>{serie.data.titulo}</h1>
    <p class="bajada">{serie.data.subtitulo}</p>
    <div class="intro"><Content /></div>
    <Tejuela />
  </header>

  <section class="contenedor fotos">
    {fotos.map((f, i) => (
      <figure class:list={['foto', 'revelar', { vertical: f.vertical }]}>
        <a href={f.grande} data-visor="serie" data-pie={f.pie}>
          <Image src={f.src} alt={f.pie || `${serie.data.titulo}, fotografía ${i + 1}`} widths={[640, 1200, 1800]} sizes={f.vertical ? '(max-width: 760px) 100vw, 45vw' : '(max-width: 760px) 100vw, 90vw'} />
        </a>
        {f.pie && <figcaption>{f.pie}</figcaption>}
      </figure>
    ))}
  </section>

  <nav class="contenedor siguiente">
    <p class="etiqueta">Siguiente serie</p>
    <a href={`/fotografia/${siguiente.id}`}>{siguiente.data.titulo} &rarr;</a>
  </nav>

  <Lightbox />
</Base>

<style>
  .volver:hover { color: var(--madera); }
  .intro { max-width: 36em; margin: 28px 0 40px; color: var(--texto-2); }

  /* Fotos grandes; las verticales se agrupan de a dos */
  .fotos {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(40px, 7vw, 120px) clamp(20px, 3vw, 48px);
    align-items: center;
  }
  .foto { grid-column: 1 / -1; margin: 0; }
  .foto a { cursor: zoom-in; display: block; }
  .foto figcaption { font-size: 12px; color: var(--texto-2); margin-top: 12px; text-align: center; }
  .foto.vertical { grid-column: auto; }
  .foto :global(img) { width: 100%; }
  .foto:not(.vertical) :global(img) { max-width: 1100px; margin: 0 auto; }

  .siguiente { padding-top: var(--aire); text-align: center; }
  .siguiente a { font-family: var(--serif); font-size: clamp(30px, 4vw, 48px); display: inline-block; margin-top: 12px; }
  .siguiente a:hover { color: var(--madera); }

  @media (max-width: 760px) {
    .fotos { grid-template-columns: 1fr; gap: 28px; }
  }
</style>
