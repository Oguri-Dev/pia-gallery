---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { getSeries } from '../../lib/contenido';

const series = await getSeries();
---
<Base titulo="Fotografía" descripcion="Series fotográficas de Pía Gallardo.">
  <header class="cabecera-seccion contenedor">
    <p class="etiqueta">Fotografía</p>
    <h1>Series</h1>
    <p class="bajada">Trabajar por series ayuda a construir un relato visual.</p>
  </header>

  <section class="contenedor rejilla">
    {series.map((s, i) => (
      <a href={`/fotografia/${s.id}`} class="serie revelar">
        <div class="marco">
          <Image src={s.data.portada} alt={s.data.titulo} widths={[640, 1200]} sizes="(max-width: 760px) 100vw, 50vw" />
        </div>
        <div class="pie-serie">
          <p class="etiqueta">{String(i + 1).padStart(2, '0')}</p>
          <div>
            <h2>{s.data.titulo}</h2>
            <p class="sub">{s.data.subtitulo} · {s.data.fotos.length} fotografías</p>
          </div>
        </div>
      </a>
    ))}
  </section>
</Base>

<style>
  .rejilla { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(40px, 5vw, 80px) clamp(24px, 4vw, 64px); }
  .serie:nth-child(even) { margin-top: clamp(0px, 8vw, 120px); }
  .marco { overflow: hidden; }
  .marco :global(img) { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; transition: transform 1.2s ease; }
  .serie:hover .marco :global(img) { transform: scale(1.03); }
  .pie-serie { display: flex; gap: 20px; margin-top: 22px; }
  .pie-serie .etiqueta { padding-top: 10px; }
  h2 { font-size: clamp(28px, 3vw, 38px); }
  .sub { color: var(--texto-2); font-size: 13px; margin-top: 6px; }
  @media (max-width: 760px) {
    .rejilla { grid-template-columns: 1fr; }
    .serie:nth-child(even) { margin-top: 0; }
  }
</style>
